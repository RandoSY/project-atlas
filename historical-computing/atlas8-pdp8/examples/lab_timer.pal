/ ATLAS DEVICE 54, TIMER_A PERIOD CAPTURE, NOMINAL 1 MHZ
/ RISING EDGES ON MSP430 P2.1. 32-BIT RESULT, LOW AND HIGH 12-BIT WORDS.
LABRDY=6542
LABTIM=6543
LABGET=6544
LABHI=6546
LABTOP=6547
*0200
        LABTIM
WAIT,   LABRDY
        JMP WAIT
        CLA
        LABTOP
        DCA TOP
        CLA
        LABHI
        DCA UPPER
        CLA
        LABGET
        DCA LOWER
        HLT
TOP,    0
UPPER,  0
LOWER,  0
$
